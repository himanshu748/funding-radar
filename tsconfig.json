{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true
  },
  "include": [
    "shared/**/*.ts",
    "providers/**/*.ts",
    "*/src/**/*.ts",
    "*/test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
