# Saved preview is the default. This file is a reference and is not loaded automatically.
# See funding-radar/docs/LIVE_RESEARCH.md before enabling any paid operation.
FUNDING_RADAR_PORT=4391
FUNDING_RADAR_LIVE=0
BOUNTY_POOL_LIVE=0

# Live sessions require both flags=1, an existing owner-approved grant, its
# initialized bound ledger, and a matching existing private key file.
# These placeholders grant no authority and point to no usable credential.
FUNDING_RADAR_POLICY_ID=funding-radar-one-run-20
FUNDING_RADAR_TARGET_ROWS=20
BOUNTY_POOL_GRANT_FILE=/absolute/private/funding-radar/grant.json
TINYFISH_KEY_FILE=/absolute/private/tinyfish-key.env
